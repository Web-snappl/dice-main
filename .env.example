# Deployment
PORT=3000
CORS_ORIGINS=https://dice-worldweb.netlify.app,http://localhost:5173

# Database
MONGO_URI=mongodb+srv://...

# Auth & Secrets
JWT_SECRET=...
JWT_REFRESH_SECRET=...
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d
CRYPTOGRAPHY_SECRET=...

# Stripe account top-ups from the landing page (https://docs.stripe.com)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# FedaPay (https://fedapay.com)
FEDAPAY_SANDBOX=true
FEDAPAY_SECRET_KEY=sk_sandbox_...
FEDAPAY_PUBLIC_KEY=pk_sandbox_...
FEDAPAY_WEBHOOK_SECRET=whsec_...
FEDAPAY_CURRENCY=XOF
# Callback URL FedaPay redirects to after checkout; the mobile WebView intercepts this.
FEDAPAY_CALLBACK_URL=https://dice-world-api.onrender.com/api/fedapay/return
# Set to "false" to require manual payout approval in the FedaPay dashboard.
FEDAPAY_PAYOUT_AUTOSTART=true
